programa
{
	
	funcao inicio()
	{
		inteiro ano,mes,dia,total
		escreva("Informe que vc tem anos: ")
		leia(ano)
		escreva("Informe que vc tem meses: ")
		leia(mes)
		escreva("Infore que vc tem dias: ")
		leia(dia)
		total=(ano*365)+(mes*30)+dia
		escreva("O resultao é: ",total)
		
	}
}
