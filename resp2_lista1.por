programa
{
	
	funcao inicio()
	{
		inteiro base,altura,area
		escreva("Informe o numero da base: ")
		leia(base)
		escreva("Informe o numero da altura: ")
		leia(altura)
		area=base*altura
		escreva("A area de retangulo é: ",area)
	}
}
