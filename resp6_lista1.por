programa
{
	
	funcao inicio()
	{
		real fabri,distri,impos,final
		escreva("Digite o custo de fabrica: R$")
		leia(fabri)
		distri=fabri*28/100.0
		impos=fabri*45/100.0
		final=fabri+distri+impos
		escreva("O custo final é: R$",final)
		
	}
}
